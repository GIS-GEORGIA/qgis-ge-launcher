{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "QGIS.GE",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "version": "1.0.1",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/GIS-GEORGIA/qgis-ge-launcher",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "__MSG_cmdOpen__"
    }
  }
}
